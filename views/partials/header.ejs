<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= config.explorerName %> - Blockchain explorer for <%= config.coinName %>">
    <link rel="icon" href="<%= config.logoUrl %>" type="image/svg+xml">
    <title>
        <%= title %> | <%= config.explorerName %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <script>
        // Initialize theme from localStorage before render to prevent flash
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand">
                <img src="<%= config.logoUrl %>" alt="<%= config.coinName %>" class="logo-img">
                <span>
                    <%= config.explorerName %>
                </span>
            </a>

            <form class="search-form" action="/search" method="GET">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="q" placeholder="Search block, transaction, or address..." class="search-input">
            </form>

            <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
                <i class="fas fa-bars"></i>
                <i class="fas fa-times"></i>
            </button>

            <div class="nav-links nav-links-desktop">
                <a href="/" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-chart-line"></i><span>Dashboard</span></a>
                <a href="/blocks" class="nav-link <%= page === 'blocks' ? 'active' : '' %>"><i class="fas fa-cube"></i><span>Blocks</span></a>
                <a href="/transactions" class="nav-link <%= page === 'transactions' ? 'active' : '' %>"><i class="fas fa-exchange-alt"></i><span>Transactions</span></a>
                <a href="/mining" class="nav-link <%= page === 'mining' ? 'active' : '' %>"><i class="fas fa-hammer"></i><span>Mining</span></a>
                <a href="/mempool" class="nav-link <%= page === 'mempool' ? 'active' : '' %>"><i class="fas fa-layer-group"></i><span>Mempool</span></a>
                <a href="/statistics" class="nav-link <%= page === 'statistics' ? 'active' : '' %>"><i class="fas fa-chart-bar"></i><span>Statistics</span></a>
                <a href="/supply" class="nav-link <%= page === 'supply' ? 'active' : '' %>"><i class="fas fa-chart-area"></i><span>Supply</span></a>
                <a href="/coin-flow" class="nav-link <%= page === 'coin-flow' ? 'active' : '' %>"><i class="fas fa-project-diagram"></i><span>Coin Flow</span></a>
                <a href="/emission" class="nav-link <%= page === 'emission' ? 'active' : '' %>"><i class="fas fa-coins"></i><span>Emission</span></a>
                <a href="/holders" class="nav-link <%= page === 'holders' ? 'active' : '' %>"><i class="fas fa-users"></i><span>Holders</span></a>
                <a href="/richlist" class="nav-link <%= page === 'richlist' ? 'active' : '' %>"><i class="fas fa-coins"></i><span>Rich List</span></a>
                <a href="/nodes" class="nav-link <%= page === 'nodes' ? 'active' : '' %>"><i class="fas fa-network-wired"></i><span>Nodes</span></a>
                <a href="/network-traffic" class="nav-link <%= page === 'network-traffic' ? 'active' : '' %>"><i class="fas fa-traffic-light"></i><span>Network Traffic</span></a>
                <a href="/chain-tips" class="nav-link <%= page === 'chain-tips' ? 'active' : '' %>"><i class="fas fa-code-branch"></i><span>Chain Tips</span></a>
                <a href="/reorgs" class="nav-link <%= page === 'reorgs' ? 'active' : '' %>"><i class="fas fa-exchange-alt"></i><span>Reorgs</span></a>
                <a href="/orphans" class="nav-link <%= page === 'orphans' ? 'active' : '' %>"><i class="fas fa-unlink"></i><span>Orphans</span></a>
                <a href="/chain-health" class="nav-link <%= page === 'chain-health' ? 'active' : '' %>"><i class="fas fa-heartbeat"></i><span>Health</span></a>
                <a href="/difficulty" class="nav-link <%= page === 'difficulty' ? 'active' : '' %>"><i class="fas fa-mountain"></i><span>Difficulty</span></a>
                <a href="/api-docs" class="nav-link <%= page === 'api' ? 'active' : '' %>"><i class="fas fa-code"></i><span>API</span></a>
                <a href="/glossary" class="nav-link <%= page === 'glossary' ? 'active' : '' %>"><i class="fas fa-book"></i><span>Glossary</span></a>
            </div>

            <!-- Theme Toggle -->
            <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
                <i class="fas fa-moon" id="theme-icon"></i>
                <span class="theme-label">Theme</span>
            </button>
        </div>

        <!-- Mobile hamburger modal (outside container so it can overlay full viewport) -->
        <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
        <div class="nav-modal-panel" id="nav-links" role="dialog" aria-label="Navigation menu">
            <div class="nav-modal-header">
                <span class="nav-modal-title">Menu</span>
                <button type="button" class="nav-modal-close" aria-label="Close menu" id="nav-close-btn">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="nav-links-scroll">
                <a href="/" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/blocks" class="nav-link <%= page === 'blocks' ? 'active' : '' %>">
                    <i class="fas fa-cube"></i>
                    <span>Blocks</span>
                </a>
                <a href="/transactions" class="nav-link <%= page === 'transactions' ? 'active' : '' %>">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Transactions</span>
                </a>
                <a href="/mining" class="nav-link <%= page === 'mining' ? 'active' : '' %>">
                    <i class="fas fa-hammer"></i>
                    <span>Mining</span>
                </a>
                <a href="/mempool" class="nav-link <%= page === 'mempool' ? 'active' : '' %>">
                    <i class="fas fa-layer-group"></i>
                    <span>Mempool</span>
                </a>
                <a href="/statistics" class="nav-link <%= page === 'statistics' ? 'active' : '' %>">
                    <i class="fas fa-chart-bar"></i>
                    <span>Statistics</span>
                </a>
                <a href="/supply" class="nav-link <%= page === 'supply' ? 'active' : '' %>">
                    <i class="fas fa-chart-area"></i>
                    <span>Supply</span>
                </a>
                <a href="/coin-flow" class="nav-link <%= page === 'coin-flow' ? 'active' : '' %>">
                    <i class="fas fa-project-diagram"></i>
                    <span>Coin Flow</span>
                </a>
                <a href="/emission" class="nav-link <%= page === 'emission' ? 'active' : '' %>">
                    <i class="fas fa-coins"></i>
                    <span>Emission</span>
                </a>
                <a href="/holders" class="nav-link <%= page === 'holders' ? 'active' : '' %>">
                    <i class="fas fa-users"></i>
                    <span>Holders</span>
                </a>
                <a href="/richlist" class="nav-link <%= page === 'richlist' ? 'active' : '' %>">
                    <i class="fas fa-coins"></i>
                    <span>Rich List</span>
                </a>
                <a href="/nodes" class="nav-link <%= page === 'nodes' ? 'active' : '' %>">
                    <i class="fas fa-network-wired"></i>
                    <span>Nodes</span>
                </a>
                <a href="/network-traffic" class="nav-link <%= page === 'network-traffic' ? 'active' : '' %>">
                    <i class="fas fa-traffic-light"></i>
                    <span>Network Traffic</span>
                </a>
                <a href="/chain-tips" class="nav-link <%= page === 'chain-tips' ? 'active' : '' %>">
                    <i class="fas fa-code-branch"></i>
                    <span>Chain Tips</span>
                </a>
                <a href="/reorgs" class="nav-link <%= page === 'reorgs' ? 'active' : '' %>">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Reorgs</span>
                </a>
                <a href="/orphans" class="nav-link <%= page === 'orphans' ? 'active' : '' %>">
                    <i class="fas fa-unlink"></i>
                    <span>Orphans</span>
                </a>
                <a href="/chain-health" class="nav-link <%= page === 'chain-health' ? 'active' : '' %>">
                    <i class="fas fa-heartbeat"></i>
                    <span>Health</span>
                </a>
                <a href="/difficulty" class="nav-link <%= page === 'difficulty' ? 'active' : '' %>">
                    <i class="fas fa-mountain"></i>
                    <span>Difficulty</span>
                </a>
                <a href="/api-docs" class="nav-link <%= page === 'api' ? 'active' : '' %>">
                    <i class="fas fa-code"></i>
                    <span>API</span>
                </a>
                <a href="/glossary" class="nav-link <%= page === 'glossary' ? 'active' : '' %>">
                    <i class="fas fa-book"></i>
                    <span>Glossary</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">