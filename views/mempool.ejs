<%- include('partials/header') %>

    <div class="mempool-page">
        <div class="page-header">
            <h1><i class="fas fa-layer-group"></i> Mempool</h1>
            <p class="page-subtitle">Unconfirmed transactions currently waiting to be included in a block.</p>
        </div>

        <!-- Mempool Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">PENDING TRANSACTIONS</span>
                    <i class="fas fa-list-alt stat-icon"></i>
                </div>
                <div class="stat-value"><%= formatNumber(stats.count || 0) %></div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">TOTAL SIZE</span>
                    <i class="fas fa-database stat-icon"></i>
                </div>
                <div class="stat-value"><%= formatBytes((stats.vsize || 0) * 1) %></div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">TOTAL FEES</span>
                    <i class="fas fa-coins stat-icon"></i>
                </div>
                <div class="stat-value">
                    <%= stats.total_fee ? (stats.total_fee / 100000000).toFixed(8) : '0.00000000' %>
                    <span class="currency"><%= config.coinTicker %></span>
                </div>
            </div>
        </div>

        <% if (feeHistogram && feeHistogram.length > 0 && (feeHistogram[0][1] || 0) > 0) { %>
        <!-- Fee rate distribution (sat/vB vs cumulative vB) -->
        <div class="content-card">
            <div class="card-header">
                <h2><i class="fas fa-chart-area"></i> Fee Rate Distribution</h2>
            </div>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Fee rate (sat/vB)</th>
                            <th>Cumulative vSize (vB)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% feeHistogram.forEach(function(row) { %>
                            <tr>
                                <td><%= typeof row[0] === 'number' ? row[0].toFixed(2) : row[0] %></td>
                                <td><%= formatNumber(typeof row[1] === 'number' ? row[1] : 0) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

        <!-- Pending transactions (with detail) -->
        <div class="content-card">
            <div class="card-header">
                <h2><i class="fas fa-clock"></i> Pending Transactions</h2>
                <span class="badge badge-pending">
                    <%= typeof total === 'number' ? formatNumber(total) : '0' %> total · showing <%= pending.length %>
                </span>
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Value</th>
                            <th>Fee</th>
                            <th>Fee Rate</th>
                            <th>Virtual Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!pending || pending.length === 0) { %>
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <p>No transactions currently in the mempool.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% pending.forEach(function(tx) { %>
                                <%
                                  var txidStr = typeof tx.txid === 'string' ? tx.txid : (tx.txid && tx.txid.toString ? tx.txid.toString() : '');
                                %>
                                <tr class="clickable-row" onclick="window.location='/tx/<%= txidStr %>'">
                                    <td>
                                        <span class="hash-value" title="<%= txidStr %>">
                                            <%= formatHash(txidStr, 24) %>
                                            <button class="copy-btn"
                                                onclick="event.stopPropagation(); copyToClipboard('<%= txidStr %>')"
                                                title="Copy">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                        </span>
                                    </td>
                                    <td>
                                        <%= tx.value != null ? (tx.value / 100000000).toFixed(8) : '0.00000000' %>
                                        <span class="currency"><%= config.coinTicker %></span>
                                    </td>
                                    <td>
                                        <%= tx.fee != null ? (tx.fee / 100000000).toFixed(8) : '0.00000000' %>
                                        <span class="currency"><%= config.coinTicker %></span>
                                    </td>
                                    <td>
                                        <% if (tx.fee != null && tx.vsize) { %>
                                            <%= (tx.fee / tx.vsize).toFixed(2) %> sat/vB
                                        <% } else { %>
                                            --
                                        <% } %>
                                    </td>
                                    <td>
                                        <%= tx.vsize != null ? tx.vsize : 0 %> vB
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (typeof total === 'number' && total > 0 && (startIndex > 0 || total > limit)) { %>
            <div class="pagination-bar">
                <% var prevStart = Math.max(0, startIndex - limit); var nextStart = startIndex + limit; %>
                <% if (startIndex > 0) { %>
                    <a href="/mempool?start_index=<%= prevStart %>&limit=<%= limit %>" class="pagination-btn"><i class="fas fa-chevron-left"></i> Previous</a>
                <% } %>
                <span class="pagination-info">
                    <%= startIndex + 1 %>–<%= Math.min(startIndex + limit, total) %> of <%= formatNumber(total) %>
                </span>
                <% if (nextStart < total) { %>
                    <a href="/mempool?start_index=<%= nextStart %>&limit=<%= limit %>" class="pagination-btn">Next <i class="fas fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>

<%- include('partials/footer') %>

